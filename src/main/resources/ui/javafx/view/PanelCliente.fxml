<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>

<VBox prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21"
  xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="md.ui.impl.javafx.controller.PanelClienteController">
  <children>
    <AnchorPane maxHeight="-1.0" maxWidth="-1.0" prefHeight="-1.0" prefWidth="-1.0"
      VBox.vgrow="ALWAYS">
      <children>
        <WebView fx:id="mapaView" layoutX="313.0" layoutY="7.0" maxHeight="400.0" maxWidth="600.0"
          prefHeight="368.0" prefWidth="486.0" style="-fx-max-height: 400;"
          AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />

        <Label fx:id="labelClienteOrigen" layoutX="14.0" layoutY="4.0" prefHeight="19.0"
          prefWidth="76.0" text="%client.label.origin" />
        <TextField fx:id="txtLatOrigen" layoutX="14.0" layoutY="27.0" />
        <TextField fx:id="txtLonOrigen" layoutX="14.0" layoutY="62.0" />
        <Button fx:id="botonClienteBorrarOrigen" layoutX="198.0" layoutY="23.0"
          mnemonicParsing="false" onAction="#handleBorrarOrigen" text="%client.delete.origin" />

        <Label fx:id="labelClienteDestino" layoutX="14.0" layoutY="102.0" prefHeight="19.0"
          prefWidth="76.0" text="%client.label.destination" />
        <TextField fx:id="txtLatDestino" layoutX="14.0" layoutY="122.0" />
        <TextField fx:id="txtLonDestino" layoutX="14.0" layoutY="157.0" />
        <Button fx:id="botonClienteBorrarDestino" layoutX="198.0" layoutY="134.0"
          mnemonicParsing="false" onAction="#handleBorrarDestino" text="%client.delete.destination" />
      </children>
    </AnchorPane>
  </children>
</VBox>